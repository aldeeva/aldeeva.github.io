<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الديفا - مدونة السفر والجمال</title>
    <link rel="stylesheet" href="/css/style.css">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1234567890123456"
     crossorigin="anonymous"></script>
</head>
<body>
    <!-- الرأس والتنقل -->
    <header>
        <nav class="navbar">
            <div class="container">
                <div class="logo">
                    <a href="/">الديفا</a>
                </div>
                <ul class="nav-menu">
                    <li><a href="/">الرئيسية</a></li>
                    <li><a href="/blog">المدونة</a></li>
                    <li><a href="/about">من نحن</a></li>
                    <li><a href="/contact">اتصل بنا</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        <!-- البانر الرئيسي -->
        <section class="hero">
            <div class="hero-content">
                <h1>مرحباً بك في الديفا</h1>
                <p>اكتشفي عالم السفر والجمال معنا</p>
                <a href="/blog" class="btn btn-primary">استكشفي المدونة</a>
            </div>
        </section>

        <!-- إعلان Google AdSense -->
        <div class="container">
            <div class="ad-space">
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="ca-pub-1234567890123456"
                     data-ad-slot="1234567890"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
                <script>
                     (adsbygoogle = window.adsbygoogle || []).push({});
                </script>
            </div>
        </div>

        <!-- المقالات المميزة -->
        <section class="featured-articles">
            <div class="container">
                <h2>أحدث المقالات</h2>
                <div class="articles-grid">
                    <% articles.forEach(article => { %>
                        <article class="article-card">
                            <div class="article-image">
                                <img src="<%= article.image %>" alt="<%= article.title %>">
                                <span class="category-badge"><%= article.category %></span>
                            </div>
                            <div class="article-content">
                                <h3><a href="/blog/<%= article.id %>"><%= article.title %></a></h3>
                                <p class="article-excerpt"><%= article.excerpt %></p>
                                <div class="article-meta">
                                    <span class="date"><%= article.date %></span>
                                    <span class="author">بقلم: <%= article.author %></span>
                                </div>
                                <a href="/blog/<%= article.id %>" class="read-more">اقرأ المزيد</a>
                            </div>
                        </article>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- إعلان Google AdSense آخر -->
        <div class="container">
            <div class="ad-space">
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="ca-pub-1234567890123456"
                     data-ad-slot="9876543210"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
                <script>
                     (adsbygoogle = window.adsbygoogle || []).push({});
                </script>
            </div>
        </div>

        <!-- قسم الاشتراك -->
        <section class="newsletter">
            <div class="container">
                <h2>اشتركي في نشرتنا البريدية</h2>
                <p>احصلي على أحدث المقالات والنصائح مباشرة في بريدك الإلكتروني</p>
                <form class="newsletter-form">
                    <input type="email" placeholder="بريدك الإلكتروني" required>
                    <button type="submit" class="btn btn-primary">اشتركي الآن</button>
                </form>
            </div>
        </section>
    </main>

    <!-- التذييل -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>الديفا</h3>
                    <p>مدونة متخصصة في السفر والجمال والعناية الشخصية</p>
                </div>
                <div class="footer-section">
                    <h3>الروابط السريعة</h3>
                    <ul>
                        <li><a href="/">الرئيسية</a></li>
                        <li><a href="/blog">المدونة</a></li>
                        <li><a href="/about">من نحن</a></li>
                        <li><a href="/contact">اتصل بنا</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>تابعنا</h3>
                    <ul class="social-links">
                        <li><a href="#">Facebook</a></li>
                        <li><a href="#">Instagram</a></li>
                        <li><a href="#">Twitter</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 الديفا - جميع الحقوق محفوظة</p>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
