<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>اتصل بنا - الديفا</title>
    <link rel="stylesheet" href="/css/style.css">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1234567890123456"
     crossorigin="anonymous"></script>
</head>
<body>
    <!-- الرأس والتنقل -->
    <header>
        <nav class="navbar">
            <div class="container">
                <div class="logo">
                    <a href="/">الديفا</a>
                </div>
                <ul class="nav-menu">
                    <li><a href="/">الرئيسية</a></li>
                    <li><a href="/blog">المدونة</a></li>
                    <li><a href="/about">من نحن</a></li>
                    <li><a href="/contact">اتصل بنا</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <!-- عنوان الصفحة -->
            <section class="page-header">
                <h1>اتصل بنا</h1>
                <p>نحب أن نسمع منك</p>
            </section>

            <!-- نموذج التواصل -->
            <section class="contact-section">
                <div class="contact-form">
                    <h2>أرسل لنا رسالة</h2>
                    <form method="POST" action="/contact">
                        <div class="form-group">
                            <label for="name">الاسم</label>
                            <input type="text" id="name" name="name" required>
                        </div>

                        <div class="form-group">
                            <label for="email">البريد الإلكتروني</label>
                            <input type="email" id="email" name="email" required>
                        </div>

                        <div class="form-group">
                            <label for="message">الرسالة</label>
                            <textarea id="message" name="message" rows="6" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">أرسل الرسالة</button>
                    </form>
                </div>

                <div class="contact-info">
                    <h2>معلومات التواصل</h2>
                    <div class="info-item">
                        <h3>البريد الإلكتروني</h3>
                        <p><a href="mailto:info@aldiva.com">info@aldiva.com</a></p>
                    </div>
                    <div class="info-item">
                        <h3>وسائل التواصل الاجتماعي</h3>
                        <ul class="social-links">
                            <li><a href="#">Facebook</a></li>
                            <li><a href="#">Instagram</a></li>
                            <li><a href="#">Twitter</a></li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- إعلان Google AdSense -->
            <div class="ad-space">
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="ca-pub-1234567890123456"
                     data-ad-slot="1234567890"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
                <script>
                     (adsbygoogle = window.adsbygoogle || []).push({});
                </script>
            </div>
        </div>
    </main>

    <!-- التذييل -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>الديفا</h3>
                    <p>مدونة متخصصة في السفر والجمال والعناية الشخصية</p>
                </div>
                <div class="footer-section">
                    <h3>الروابط السريعة</h3>
                    <ul>
                        <li><a href="/">الرئيسية</a></li>
                        <li><a href="/blog">المدونة</a></li>
                        <li><a href="/about">من نحن</a></li>
                        <li><a href="/contact">اتصل بنا</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>تابعنا</h3>
                    <ul class="social-links">
                        <li><a href="#">Facebook</a></li>
                        <li><a href="#">Instagram</a></li>
                        <li><a href="#">Twitter</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 الديفا - جميع الحقوق محفوظة</p>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
